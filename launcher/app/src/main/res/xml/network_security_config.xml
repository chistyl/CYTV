<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Keep the normal Android system trust store for every destination. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Aerial videos are served by Apple's sylvan host. Permit an explicitly installed
         user CA for this host only; normal hostname and certificate-chain validation remain enabled. -->
    <domain-config>
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
