<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#FF16434B" />
            <stroke android:width="2dp" android:color="#FF00D7D7" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FF16434B" />
            <stroke android:width="1dp" android:color="#FF00D7D7" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#E6263447" />
            <stroke android:width="1dp" android:color="#334FFFFFF" />
        </shape>
    </item>
</selector>