<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#55465366" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/cytv_accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#33465366" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/cytv_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cytv_surface_elevated" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
